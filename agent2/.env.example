# 이 파일을 `agent2/.env`로 복사하고 키를 채운다. `.env`는 커밋하지 않는다.
# 읽는 순서: `agent2/.env` → 저장소 루트 `.env`. 먼저 찾은 하나만 읽는다.

LLM_PROFILE=hcx
CLOVA_API_KEY=<CLOVA Studio API 키>

# LLM_MODEL=HCX-005     # 생략하면 프로필 기본값(HCX-005)

# ★ **서비스 API 키**여야 한다. 테스트 키로는 HCX-005가 열리지 않는다.
# ★ `LLM_PROFILE` 한 줄이 없으면 경고 없이 개발용 프로필(openai)로 떨어진다.
#   서빙 전에 반드시 확인한다 — 네트워크 호출은 없다:
#       python3 -m agent2.core.llm
#       → 현재 프로필: hcx (HCX-005) — 실호출 가능

# 개발용 OpenAI로 바꾸려면 위 두 줄 대신:
#   LLM_PROFILE=openai
#   OPENAI_API_KEY=<키>
